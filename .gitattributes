# Normalize all text files to LF in the repository and on checkout.
# Keeps the tree identical across WSL (LF) and Windows (previously CRLF),
# so switching between the two never rewrites line endings repo-wide.
* text=auto eol=lf

# --- Explicit text types (belt and braces) ---
*.go      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.svg     text eol=lf
*.env     text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
LICENSE   text eol=lf

# Shell scripts must stay LF or they break under bash.
*.sh      text eol=lf

# Windows-only scripts genuinely need CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# --- Binary: never touch line endings, never diff as text ---
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.bmp     binary
*.pdf     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.eot     binary
*.zip     binary
*.gz      binary
*.tar     binary
*.7z      binary
*.rar     binary
*.mp3     binary
*.mp4     binary
*.webm    binary
*.wasm    binary
*.so      binary
*.dll     binary
*.dylib   binary
*.exe     binary
*.docx    binary
*.xlsx    binary
*.pptx    binary

# Lockfiles: keep out of diffs to reduce review noise.
package-lock.json -diff linguist-generated
go.sum            -diff
