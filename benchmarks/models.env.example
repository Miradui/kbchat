# Copy to output/benchmarks-models.env; use host.docker.internal for host services.
# Only these ten keys are accepted. No database, MinIO, proxy or OTEL settings.
CHAT_BASE_URL=https://api.example.com/v1
CHAT_API_KEY=replace-me
CHAT_MODEL=replace-me
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
RERANK_BASE_URL=http://host.docker.internal:8081
RERANK_API_KEY=local
RERANK_MODEL=ollama-reranker
