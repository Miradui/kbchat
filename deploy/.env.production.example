# Copy to deploy/.env.production; chmod 600. Never commit actual credentials.
# Stable Compose project name: do not change it during upgrades (owns the volumes).
COMPOSE_PROJECT_NAME=kbchat
KBCHAT_VERSION=local
KBCHAT_BIND=127.0.0.1
KBCHAT_PORT=8088
KBCHAT_SUBNET=172.30.80.0/24
# Dynamic pool excludes the fixed Nginx IP, including one-off admin jobs.
KBCHAT_DYNAMIC_RANGE=172.30.80.128/25
KBCHAT_PROXY_IP=172.30.80.2
# Required. Generate EACH separately using: openssl rand -hex 32
# POSTGRES_PASSWORD must be URL-safe (hex recommended).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Use endpoints reachable FROM containers; 127.0.0.1 means the container itself.
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.openai.com/v1
RERANK_API_KEY=
RERANK_MODEL=
RERANK_FAILURE_MODE=strict
STORAGE_PROVIDER=local
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8088
PDF_OCR_ENABLED=false
# The image includes Poppler/Tesseract and English/Simplified-Chinese data.
PDF_OCR_LANGUAGES=chi_sim+eng
# Optional external observability stack, full OTLP/HTTP URLs.
OTEL_SERVICE_NAME=rag-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Set only for the one-off bootstrap-admin command, then remove it.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
