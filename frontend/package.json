{
  "name": "kbchat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src --max-warnings 0",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "build": "tsc -b && vite build && npm run verify:route-chunks",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify:route-chunks": "node scripts/verify-route-chunks.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "@vitejs/plugin-react": "^5.1.1",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.24.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript-eslint": "^8.70.1",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "^4.1.10"
  }
}
