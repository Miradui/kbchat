# App
APP_ENV=development
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# OpenTelemetry: empty endpoint keeps local trace/log correlation without export.
# Local stack: docker compose -f deploy/docker-compose.yml --profile observability up -d grafana
OTEL_SERVICE_NAME=rag-backend
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Example endpoint: http://127.0.0.1:4318/v1/traces
# Metrics endpoint: http://127.0.0.1:4318/v1/metrics
# Local scratch databases only. Creates missing tables from the GORM models, which
# lack the CHECK constraints and foreign keys in backend/migrations; ignored when
# APP_ENV=production. Leave false and run the migrations instead.
RAG_ALLOW_AUTOMIGRATE=false

# PostgreSQL (timestamptz; application sessions use UTC)
DATABASE_URL=postgres://rag:rag@localhost:5432/rag?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_OPERATION_TIMEOUT=200ms
REDIS_FAILURE_COOLDOWN=5s
# Fixed-window request limits. Trusted proxy CIDRs are the only peers whose
# X-Forwarded-For header is accepted when deriving the login client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_FAILURE_MODE=open
TRUSTED_PROXY_CIDRS=
# Query embedding vectors are cached in Redis by model and normalized query.
EMBEDDING_CACHE_TTL=24h

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# Operator-only first administrator creation (cmd/bootstrap-admin -username NAME -create).
# Leave the password empty unless creating a new administrator; promotion preserves credentials.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Model provider
MODEL_PROVIDER=openai_compatible

# Chat provider
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=replace-with-chat-api-key
CHAT_MODEL=gpt-4.1-mini
# Comma-separated models a knowledge base may pick as its answer model; empty disables per-KB overrides.
CHAT_ALLOWED_MODELS=
# Per-million-token prices keyed by model, e.g. {"gpt-4.1-mini":{"prompt":0.4,"completion":1.6}}; {} shows token counts only.
MODEL_PRICING={}

# Title provider, used to summarize the first user question into a session title.
TITLE_BASE_URL=https://api.openai.com/v1
TITLE_API_KEY=replace-with-title-api-key
TITLE_MODEL=gpt-4.1-mini

# Embedding provider
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Rerank provider
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.openai.com/v1
RERANK_API_KEY=replace-with-rerank-api-key
RERANK_MODEL=rerank-model-name
RERANK_FAILURE_MODE=strict

# Document storage. Set STORAGE_PROVIDER=minio to use S3-compatible MinIO.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=rag-documents
MINIO_REGION=
MINIO_USE_SSL=false
MAX_UPLOAD_SIZE_MB=50

# How long a processed document may go without an update before the UI flags it
# as possibly out of date. 0 disables the flag. Stale documents are never deleted
# and never down-weighted in retrieval -- old is not the same as wrong.
STALE_DOCUMENT_AFTER_DAYS=180

# Retrieval defaults
VECTOR_TOP_N=30
RERANK_TOP_K=5
SCORE_THRESHOLD=0.3
CHAT_HISTORY_LIMIT=10
# Global switch for keyword (lexeme) recall fused with vector recall before
# Rerank. false disables it for every knowledge base regardless of its config.
# Existing chunks need `go run ./cmd/reindex-keywords` once after migration 024.
KEYWORD_SEARCH_ENABLED=true

# Document worker
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=10s
STORAGE_OPERATION_TIMEOUT=2m

# Optional local OCR for PDF pages without native text. Requires Poppler,
# Tesseract 5 and matching language data; never uploads pages to a model API.
PDF_OCR_ENABLED=false
PDF_OCR_PDFTOPPM_PATH=pdftoppm
PDF_OCR_TESSERACT_PATH=tesseract
PDF_OCR_TESSDATA_DIR=
PDF_OCR_LANGUAGES=chi_sim+eng
PDF_OCR_MAX_PAGES=40
PDF_OCR_MAX_IMAGE_SIDE=3000
PDF_OCR_PAGE_TIMEOUT=30s
PDF_OCR_TIMEOUT=5m

# Frontend, only needed when frontend is served from a different origin.
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
